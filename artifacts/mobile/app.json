{
  "expo": {
    "name": "Jazment",
    "slug": "jazment",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/dragon-tiger-casino-wide.png",
    "scheme": "mobile",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "updates": {
      "enabled": false,
      "useEmbeddedUpdate": true
    },
    "splash": {
      "image": "./assets/images/dragon-tiger-casino-wide.png",
      "resizeMode": "contain",
      "backgroundColor": "#F47D1C"
    },
    "ios": {
      "supportsTablet": false
    },
    "android": {},
    "web": {
      "favicon": "./assets/images/dragon-tiger-casino-wide.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      [
        "expo-screen-orientation",
        {
          "initialOrientation": "PORTRAIT_UP"
        }
      ],
      "expo-web-browser",
      "expo-audio",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
