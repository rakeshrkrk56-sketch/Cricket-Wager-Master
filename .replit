modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
E2E_TEST_SECRET = "dev-e2e-secret"
MSG91_TEMPLATE_ID = "curl --request POST \\   --url 'https://control.msg91.com/api/v5/otp?template_id=&mobile=&authkey=' \\   --header 'Content-Type: application/JSON' \\   --header 'content-type: application/json' \\   --data '{   \"Param1\": \"value1\",   \"Param2\": \"value2\",   \"Param3\": \"value3\" }'"
